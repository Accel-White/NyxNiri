// 全局窗口规则 (几何结构)
window-rule {
    // 圆角
    geometry-corner-radius 12
    // 去掉超出圆角的窗口内容
    clip-to-geometry true
    // 禁止边框画到背景里
    draw-border-with-background false
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

layer-rule {
    match namespace="^mpvpaper$"
    place-within-backdrop true
}

// noctalia(v5.0.0) 状态栏的命名空间
layer-rule {
    match namespace="^noctalia-bar-bar$"
    opacity 1.0
    geometry-corner-radius 0
    shadow { off; }
    background-effect {
        blur false
        // xray true // 可选：如果开启，只模糊背后的壁纸，性能更好且通常观感更干净
    }
}

// ==========================================
// 特定应用规则
// ==========================================

window-rule {
    match app-id=r"dev.noctalia.Noctalia"
    open-floating true
}

window-rule {
    match app-id=r"^org\.wezfurlong\.wezterm$"
    default-column-width
}

window-rule {
    match app-id=r"^gnome-control-center$"
    match app-id=r"^pavucontrol$"
    match app-id=r"^nm-connection-editor$"
    default-column-width { proportion 0.5; }
    open-floating false
}

window-rule {
    match app-id=r"^org\.gnome\.Calculator$"
    match app-id=r"^gnome-calculator$"
    match app-id=r"^galculator$"
    match app-id=r"^blueman-manager$"
    match app-id=r"^org\.gnome\.Nautilus$"
    match app-id=r"^xdg-desktop-portal$"
    open-floating true
}

window-rule {
    match app-id=r"^steam$" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    // opened false // 默认不处于打开状态
}

window-rule {
    match app-id=r"firefox$" title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}

window-rule {
    match app-id="wine"
    open-floating true
    default-column-width { proportion 1.0; }
    draw-border-with-background false
}

// 从 glassy-niri 复制的特定应用美化规则
window-rule {
    match app-id="org.pwmt.zathura"
    opacity 0.8
    background-effect { blur true; xray true; }
}

window-rule {
    match app-id="codium"
    opacity 0.85
    background-effect { blur true; xray true; }
}

window-rule {
    match app-id="steam"
    opacity 0.9
    background-effect { blur true; xray true; }
}

window-rule {
    match app-id="obsidian"
    opacity 0.9
    background-effect { blur true; xray true; }
}

// Zen 浏览器
window-rule {
    match app-id="app.zen_browser.zen"
    draw-border-with-background false
    background-effect { blur true; xray true; }
}

window-rule {
    match app-id=r"^org\.gnome\.Nautilus$"
    draw-border-with-background false
    background-effect { blur true; xray true; }
}

// ==========================================
// 游戏专属规则：强制无特效、最高性能
// ==========================================
window-rule {
    // 1. 匹配常见的底层运行环境
    match app-id=r"^steam_app_.*"   // 匹配所有 Steam 游戏（原生或 Proton）
    match app-id=r"^gamescope$"     // 匹配 Gamescope 微型合成器
    match app-id=r"^wine$"          // 匹配普通的 Wine 运行环境

    // 2. 也可以直接通过窗口标题精准匹配（支持正则忽略大小写）
    // 比如通过第三方启动器运行的《原神》、《绝区零》等，可以直接抓取标题
    match title=r"(?i)genshin impact|zenless zone zero|victoria 3|Minecraft|Endfield"

    // 禁用透明度，恢复 100% 实体
    opacity 1.0

    // 关闭模糊效果，节省显卡算力
    background-effect {
        blur false
    }

    // 确保没有边框渲染干扰
    draw-border-with-background false
}

// 视频画中画
window-rule {
    match title="画中画"
    match title="Picture-in-Picture"

    open-floating true
    opacity 1.0

    // 让窗口自己决定初始大小，从而解锁拉伸限制
    default-column-width

    default-window-height


    // 依然可以保持右下角定位
    default-floating-position x=20 y=20 relative-to="bottom-right"
}

// 视频软件适配
window-rule {
    match app-id="org.kde.kdenlive"
    match app-id="mpv"
    match app-id="kazumi"
    opacity 1.0
}

// Ente-Auth 适配
window-rule {
    match app-id="io.ente.auth"
    open-floating true
    default-column-width { fixed 532; }
    default-window-height { fixed 925; }
}
